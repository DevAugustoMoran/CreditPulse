<?xml version="1.0" encoding="utf-8"?>
<!--
  CreditPulse.SibSimulador - Web.config

  Este proyecto es una segunda aplicación web, independiente de
  CreditPulse.Web, que simula el servicio HTTP de historial crediticio
  de la Superintendencia de Bancos (SIB). Existe para que la
  integración con la SIB deje de ser una clase C# que corre dentro del
  mismo proceso de CreditPulse.Web (ver BLL.SibMockService allá) y pase
  a ser una llamada HTTP real a otro sistema -tal como sería con la SIB
  de verdad-, algo importante para un curso de Análisis de Sistemas
  centrado en integración entre sistemas.

  No requiere base de datos ni ningún otro recurso: genera el perfil de
  forma determinística a partir del DPI recibido, igual que
  BLL.SibMockService en CreditPulse.Web (ver Models/SibPerfilGenerator.cs).

  Para usarlo desde CreditPulse.Web: publica/ejecuta este proyecto,
  copia la URL donde quedó corriendo (por ejemplo,
  https://localhost:44399/ en Visual Studio/IIS Express) al appSetting
  "SibApiBaseUrl" de CreditPulse.Web\Web.config, y pon "UsarSibMock" en
  false allá.
-->
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <validation validateIntegratedModeConfiguration="false" />
  </system.webServer>
</configuration>
