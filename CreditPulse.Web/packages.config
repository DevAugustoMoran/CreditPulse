<?xml version="1.0" encoding="utf-8"?>
<packages>
  <package id="Newtonsoft.Json" version="13.0.3" targetFramework="net48" />
  <!-- Evaluaciones Batch (Fase 2): lectura de archivos .xlsx (solo
       formato moderno) sin depender de Excel/Interop en el servidor. -->
  <package id="ExcelDataReader" version="3.6.0" targetFramework="net48" />
  <package id="ExcelDataReader.DataSet" version="3.6.0" targetFramework="net48" />
  <!-- APIs de integración (Fase 4): Web API 2 conviviendo con WebForms en
       el mismo proyecto, bajo /api/v1/... (ver Api/App_Start/WebApiConfig.cs). -->
  <package id="Microsoft.AspNet.WebApi.Core" version="5.2.9" targetFramework="net48" />
  <package id="Microsoft.AspNet.WebApi.WebHost" version="5.2.9" targetFramework="net48" />
  <package id="Microsoft.AspNet.WebApi.Client" version="5.2.9" targetFramework="net48" />
</packages>
