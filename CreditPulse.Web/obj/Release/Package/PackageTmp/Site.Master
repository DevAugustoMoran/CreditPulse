<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="CreditPulse.Web.SiteMaster" %>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CP Analítica</title>
    <script type="text/javascript">try { var t = localStorage.getItem('cp-theme'); document.documentElement.setAttribute('data-theme', t === 'light' ? 'light' : 'dark'); } catch (e) { }</script>
    <link rel="icon" type="image/x-icon" href="<%: ResolveUrl("~/Content/img/favicon.ico") %>" />
    <link rel="icon" type="image/png" sizes="64x64" href="<%: ResolveUrl("~/Content/img/favicon-64.png") %>" />
    <link rel="apple-touch-icon" href="<%: ResolveUrl("~/Content/img/apple-touch-icon.png") %>" />
    <link rel="stylesheet" href="<%: ResolveUrl("~/Content/site.css") %>" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="frmPrincipal" runat="server">
        <div class="cp-shell">

            <div id="cpBackdrop" class="cp-backdrop"></div>

            <aside class="cp-sidebar">
                <div class="cp-brand">
                    <img class="cp-brand-logo" src="<%: ResolveUrl("~/Content/img/logo-icono.png") %>" alt="" width="46" height="46" />
                    <span class="cp-brand-text">
                        <span class="cp-brand-name">CP Analítica</span>
                        <span class="cp-brand-tagline">Motor de riesgos</span>
                    </span>
                </div>

                <nav class="cp-nav">
                    <a runat="server" id="navDashboard" href="~/Default.aspx" class="cp-nav-link">
                        <span class="cp-nav-icon">&#9673;</span> Dashboard
                    </a>
                    <div runat="server" id="navGrupoEvaluacion" class="cp-nav-group-label">Evaluación</div>
                    <a runat="server" id="navNueva" href="~/Evaluacion/Nueva.aspx" class="cp-nav-link">
                        <span class="cp-nav-icon">&#43;</span> Nueva Evaluación
                    </a>
                    <a runat="server" id="navBatch" href="~/Evaluacion/Batch.aspx" class="cp-nav-link">
                        <span class="cp-nav-icon">&#8593;</span> Evaluaciones Batch
                    </a>
                    <div class="cp-nav-group-label">Reportes</div>
                    <a runat="server" id="navReporteEvaluaciones" href="~/Reportes/ReporteEvaluaciones.aspx" class="cp-nav-link">
                        <span class="cp-nav-icon">&#9636;</span> Evaluaciones por mes
                    </a>
                    <a runat="server" id="navReporteBatch" href="~/Reportes/ReporteBatch.aspx" class="cp-nav-link">
                        <span class="cp-nav-icon">&#9776;</span> Clientes por batch
                    </a>
                    <div runat="server" id="navGrupoAdmin" class="cp-nav-group-label">Administración</div>
                    <a runat="server" id="navAdminProductos" href="~/Administracion/Productos.aspx" class="cp-nav-link">
                        <span class="cp-nav-icon">&#9881;</span> Productos y Políticas
                    </a>
                    <a runat="server" id="navAdminUsuarios" href="~/Administracion/Usuarios.aspx" class="cp-nav-link">
                        <span class="cp-nav-icon">&#128100;</span> Usuarios y Roles
                    </a>
                </nav>

                <div class="cp-sidebar-footer">
                    CP Analítica (CreditPulse Analítica)<br />
                    Motor de análisis de riesgo crediticio
                </div>
            </aside>

            <div class="cp-main">
                <header class="cp-topbar">
                    <div class="cp-topbar-left">
                        <button type="button" id="cpMenuToggle" class="cp-menu-toggle" aria-label="Abrir menú" aria-expanded="false">
                            <span class="cp-menu-toggle-bar"></span>
                            <span class="cp-menu-toggle-bar"></span>
                            <span class="cp-menu-toggle-bar"></span>
                        </button>
                        <div class="cp-topbar-title">
                            <asp:ContentPlaceHolder ID="TitleContent" runat="server" />
                        </div>
                    </div>
                    <div class="cp-topbar-user">
                        <button type="button" class="cp-theme-toggle" data-cp-theme-toggle aria-label="Cambiar entre modo claro y oscuro" title="Cambiar a modo claro">
                            <svg class="cp-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                            <svg class="cp-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                        </button>
                        <span class="cp-user-name"><asp:Literal ID="litNombreUsuario" runat="server" /></span>
                        <span class="cp-user-role"><asp:Literal ID="litRolUsuario" runat="server" /></span>
                        <asp:LinkButton ID="btnCerrarSesion" runat="server" CssClass="cp-btn-logout" OnClick="btnCerrarSesion_Click">Salir</asp:LinkButton>
                    </div>
                </header>

                <main class="cp-content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </main>
            </div>
        </div>
    </form>

    <script type="text/javascript" src="<%: ResolveUrl("~/Content/cp-theme.js") %>"></script>
    <script type="text/javascript">
        // Menú lateral tipo "drawer" en pantallas angostas (ver breakpoint de
        // 980px en Content/site.css). En escritorio el botón está oculto y
        // este script no tiene efecto visible.
        (function () {
            var shell = document.querySelector('.cp-shell');
            var toggle = document.getElementById('cpMenuToggle');
            var backdrop = document.getElementById('cpBackdrop');
            if (!shell || !toggle || !backdrop) return;

            function cerrarMenu() {
                shell.classList.remove('cp-sidebar-open');
                document.body.classList.remove('cp-no-scroll');
                toggle.setAttribute('aria-expanded', 'false');
            }

            function abrirMenu() {
                shell.classList.add('cp-sidebar-open');
                document.body.classList.add('cp-no-scroll');
                toggle.setAttribute('aria-expanded', 'true');
            }

            toggle.addEventListener('click', function () {
                if (shell.classList.contains('cp-sidebar-open')) { cerrarMenu(); } else { abrirMenu(); }
            });
            backdrop.addEventListener('click', cerrarMenu);
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') cerrarMenu();
            });
        })();
    </script>
</body>
</html>
