<?xml version="1.0" encoding="utf-8"?>
<!--
  CreditPulse - Web.config
  Ajusta el connection string a tu instancia local de
  SQL Server Express 2022 antes de ejecutar el proyecto.
-->
<configuration>
  <connectionStrings>
    <!-- LOCAL con Docker (docker compose up -d). Alternativa SQL Server Express instalado en Windows:
         Data Source=localhost\SQLEXPRESS;Initial Catalog=CreditPulseDB;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True -->
    <add name="CreditPulseDB"
         connectionString="Data Source=localhost,1433;Initial Catalog=CreditPulseDB;User ID=cp_app;Password=Cp_App_2026_Local;TrustServerCertificate=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Minutos de inactividad antes de cerrar la sesión automáticamente -->
    <add key="SessionTimeoutMinutes" value="20" />
    <!-- Iteraciones PBKDF2 para el hash de contraseñas -->
    <add key="PasswordHashIterations" value="100000" />
    <!-- true = usa el simulador de SIB en memoria (BLL.SibMockService, todo
         dentro de este mismo proceso). false = consulta por HTTP al
         proyecto independiente CreditPulse.SibSimulador (BLL.SibApiClientService),
         usando la URL de "SibApiBaseUrl" -así se simula cómo se vería una
         integración real con la SIB como servicio externo. Ver
         BLL.EvaluationService.CrearSibService(). -->
    <add key="UsarSibMock" value="true" />
    <!-- URL base donde corre CreditPulse.SibSimulador (solo se usa si
         UsarSibMock = false). En Visual Studio/IIS Express normalmente
         queda en https://localhost:44399/ (puerto fijado en
         CreditPulse.SibSimulador.csproj). Incluir la barra final o no es
         indistinto: SibApiClientService la normaliza. -->
    <add key="SibApiBaseUrl" value="https://localhost:44399/" />
    <!-- Tiempo máximo (milisegundos) que se espera la respuesta de
         CreditPulse.SibSimulador antes de reportar error de conexión. -->
    <add key="SibApiTimeoutMs" value="5000" />
    <!-- APIs de integración (/api/v1/..., ver carpeta Api/ y el README):
         llave compartida que debe enviar cualquier sistema consumidor en
         el header "X-Api-Key" (ver Api/Filters/ApiKeyAuthorizeAttribute.cs).
         CAMBIA este valor antes de exponer la API fuera de tu entorno de
         pruebas: el que viene aquí es solo un ejemplo generado para esta
         entrega. -->
    <add key="ApiKeyIntegraciones" value="gemIysCWqXkClJ4BcCChAJgO8eZcD7tRltqsmL4NblxMQaIM" />
    <!-- Cuenta de servicio (ver Database/11_ApiIntegraciones.sql) usada
         para atribuir (UsuarioId) las evaluaciones creadas por
         POST /api/v1/evaluaciones, ya que ninguna persona inició sesión. -->
    <add key="ApiUsuarioIntegracionEmail" value="integracion@creditpulse.com" />
    <!-- ===== CP Analítica: configuración nueva ===== -->
    <!-- Zona horaria con la que se MUESTRAN las fechas (la BD guarda UTC).
         Guatemala = UTC-6 sin horario de verano. -->
    <add key="ZonaHorariaId" value="Central America Standard Time" />
    <!-- true = además del formato (13 dígitos, departamento 01-22, municipio
         válido) se verifica el dígito verificador del DPI. Solo aplica en la
         interfaz web y en Batch; las APIs /api/v1 no lo usan. -->
    <add key="DpiValidarDigitoVerificador" value="true" />
    <!-- Token de acceso (JWT) y refresh token para /api/v1/auth/*. Es una
         alternativa ADICIONAL al header X-Api-Key, que sigue funcionando.
         CAMBIA JwtSecret en cada ambiente (mínimo 32 caracteres, secreto). -->
    <add key="JwtSecret" value="CLVBvpWO10Fu7Nhpm_HGcS8PR0vvORhKxHSPF3gat9iikvbKcaxMvmseQtk25l_P" />
    <add key="JwtIssuer" value="cp-analitica" />
    <add key="JwtAudience" value="cp-analitica-api" />
    <add key="JwtAccessMinutes" value="15" />
    <add key="JwtRefreshDays" value="7" />
    <!-- Llave que este sistema envía (X-Api-Key) a la API de la SIB cuando
         UsarSibMock = false. Vacío = no se envía header. -->
    <add key="SibApiKey" value="" />
    <!-- Desde .NET 4.5 los validadores (RequiredFieldValidator, etc.) usan
         por defecto "validación no intrusiva", que requiere tener jQuery
         registrado vía ScriptResourceMapping. Este proyecto no incluye
         jQuery, así que se vuelve al modo clásico de validación de
         WebForms (sin dependencia de jQuery) con esta clave. -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="10240" executionTimeout="120" />

    <!-- La sesión de ASP.NET expira junto con el ticket de Forms Authentication -->
    <sessionState mode="InProc" timeout="20" cookieless="false" />

    <!-- Los archivos .aspx/.master están guardados en UTF-8. Sin esto, el
         compilador de páginas de ASP.NET los lee con la codificación ANSI
         por defecto de Windows (Windows-1252), lo que corrompe las tildes
         y la "ñ" (se ven como "Ã³", "Ã±", etc.). fileEncoding es la clave
         que soluciona el problema; requestEncoding/responseEncoding
         aseguran que los formularios y la respuesta también viajen en
         UTF-8 de extremo a extremo. -->
    <globalization
      fileEncoding="utf-8"
      requestEncoding="utf-8"
      responseEncoding="utf-8"
      culture="es-GT"
      uiCulture="es-GT" />

    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx"
             timeout="20"
             slidingExpiration="true"
             protection="All"
             name=".CREDITPULSE_AUTH"
             cookieless="UseCookies" />
    </authentication>

    <authorization>
      <deny users="?" />
    </authorization>

    <!-- Clave fija (no "AutoGenerate"): en Azure App Service, y en
         cualquier host cuyo worker process se recicle o descargue por
         inactividad (por ejemplo el plan gratuito F1), una clave
         autogenerada cambia en cada arranque del proceso, lo que invalida
         de golpe todas las cookies de Forms Authentication ya emitidas
         (".CREDITPULSE_AUTH") y obliga a todos a volver a iniciar sesión
         cada vez que el sitio "despierta" tras estar inactivo. Con una
         clave fija, la sesión sobrevive a esos reinicios. Generada una
         sola vez para esta entrega (128 y 64 caracteres hex
         respectivamente); si este proyecto se usa en algo real, se
         regenera y se guarda como secreto, no en el repositorio. -->
    <machineKey
      validationKey="07897A57CC35DDE23A2DB0F248E9AA961C102C5376FFB6F2E1A87B92ED3917587D5928069C6EC68BB38483413894C03017FCA958344181526294179478E5D976"
      decryptionKey="627FC0A6F3A20AB3A1615D277370F2C89EBC3A87228192DA72584C9CED7ED58A"
      validation="SHA1"
      decryption="AES" />

    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" />
    <pages controlRenderingCompatibilityVersion="4.0">
      <namespaces>
        <!-- Necesario para poder llamar a los métodos de extensión de
             ResultadoSemaforo (CssClass/Etiqueta) directamente en el
             markup (<%# %>) de las páginas .aspx. -->
        <add namespace="CreditPulse.Web.Models" />
      </namespaces>
    </pages>
  </system.web>

  <!-- El login y sus recursos estáticos deben quedar accesibles sin autenticar -->
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Error.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Scripts">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- Las APIs de integración (/api/v1/..., ver carpeta Api/ y el README,
       sección 1.6) se autentican con el header "X-Api-Key"
       (Api/Filters/ApiKeyAuthorizeAttribute.cs), no con el login de
       Forms Authentication -no hay ningún usuario humano detrás de una
       llamada de otro sistema-. Sin esta excepción, el módulo de Forms
       Authentication intercepta la petición antes de que llegue al
       filtro de la API y la redirige (302) a Login.aspx, devolviendo el
       HTML del login en vez del JSON/XML esperado. -->
  <location path="api">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <validation validateIntegratedModeConfiguration="false" />
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
