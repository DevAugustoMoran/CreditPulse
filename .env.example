# Copia este archivo como ".env" para cambiar los valores por defecto de docker-compose.yml.
# Son contraseñas de DESARROLLO LOCAL; no las uses en un servidor real.

# Contraseña del administrador (sa) de SQL Server. Debe tener mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=Sa_CreditPulse_2026

# Contraseña del usuario de la aplicación (cp_app). Debe coincidir con la de CreditPulse.Web/Web.config.
CP_APP_PASSWORD=Cp_App_2026_Local

# Puertos publicados en tu equipo.
MSSQL_PORT=1433
SIB_API_PORT=5080

# Llave opcional de la API de la SIB (déjala vacía para no pedir llave).
SIB_API_KEY=
